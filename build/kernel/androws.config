# Androws kernel fragment, merged onto the arch defconfig by stage 20.
# Everything here exists to serve the 512 MB / 1 GB target. Author: Saeed x Claude

# --- Android app support ---------------------------------------------------
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ASHMEM=n                 # replaced by memfd on 5.18+, saves the driver
CONFIG_MEMFD_CREATE=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_SYNC_FILE=y

# --- The freeze/thaw machinery the broker depends on ------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_PSI=y                    # /proc/pressure/memory, the early-freeze signal
CONFIG_PSI_DEFAULT_DISABLED=n

# --- Making 512 MB behave like more -----------------------------------------
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y      # lz4 over zstd here: decompress latency beats ratio
CONFIG_ZSMALLOC=y
CONFIG_SWAP=y
CONFIG_KSM=y                    # two runtimes share a lot of identical pages
CONFIG_TRANSPARENT_HUGEPAGE=n   # THP wastes memory at this size

# --- Storage ----------------------------------------------------------------
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_OVERLAY_FS=y
CONFIG_F2FS_FS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y                # ESP only

# --- Graphics and input ------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_VIRTIO_GPU=y         # so `make run` has something to draw on
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y

# --- Cut what a 1 GB image cannot afford ------------------------------------
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_KERNEL=n
CONFIG_KALLSYMS_ALL=n
CONFIG_IKCONFIG=n
CONFIG_KERNEL_ZSTD=y
CONFIG_MODULE_COMPRESS_ZSTD=y
